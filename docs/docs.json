{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "memloom",
  "colors": {
    "primary": "#d97706",
    "light": "#f59e0b",
    "dark": "#b45309"
  },
  "api": {
    "playground": {
      "display": "simple"
    },
    "params": {
      "expanded": "all"
    },
    "examples": {
      "languages": ["curl", "python", "javascript", "go", "php", "ruby", "java", "csharp"],
      "defaults": "required",
      "prefill": true,
      "autogenerate": true
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting Started",
            "pages": ["index", "features", "use-cases"]
          },
          {
            "group": "Concepts",
            "pages": [
              "concepts/architecture",
              "concepts/memory-types",
              "concepts/conflicts",
              "concepts/distillation",
              "concepts/graph",
              "concepts/retrieval",
              "concepts/assistant"
            ]
          },
          {
            "group": "Guides",
            "pages": ["guides/extractors", "guides/configuration", "guides/self-hosting"]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Endpoints",
            "pages": [
              {
                "group": "Memory",
                "openapi": "openapi.yaml",
                "expanded": false,
                "pages": [
                  "POST /memory/save",
                  "POST /memory/query",
                  "GET /memory/list",
                  "POST /memory/{id}/update",
                  "GET /memory/{id}/history",
                  "DELETE /memory/{id}",
                  "GET /memory/passage/{id}"
                ]
              },
              {
                "group": "Indexing & graph",
                "openapi": "openapi.yaml",
                "expanded": false,
                "pages": [
                  "POST /memory/index",
                  "POST /memory/index/stream",
                  "POST /memory/reindex",
                  "POST /memory/reindex/stream",
                  "GET /memory/index/runs",
                  "DELETE /memory/index/runs",
                  "GET /memory/index/runs/{id}/events",
                  "DELETE /memory/index/runs/{id}",
                  "GET /memory/auto-index",
                  "PATCH /memory/auto-index",
                  "GET /memory/graph"
                ]
              },
              {
                "group": "Schema & entities",
                "openapi": "openapi.yaml",
                "expanded": false,
                "pages": [
                  "GET /memory/schema",
                  "POST /memory/schema",
                  "PATCH /memory/schema/{id}",
                  "DELETE /memory/schema/{id}",
                  "POST /memory/schema/{id}/approve",
                  "POST /memory/schema/{id}/dismiss",
                  "GET /memory/entities",
                  "PATCH /memory/entities/{id}",
                  "POST /memory/entities/{id}/merge",
                  "DELETE /memory/entities/{id}"
                ]
              },
              {
                "group": "Assistant",
                "openapi": "openapi.yaml",
                "expanded": false,
                "pages": [
                  "POST /assistant/chat",
                  "GET /assistant/models",
                  "GET /assistant/sessions",
                  "GET /assistant/sessions/search",
                  "GET /assistant/sessions/{id}/messages",
                  "PATCH /assistant/sessions/{id}",
                  "DELETE /assistant/sessions/{id}",
                  "DELETE /assistant/sessions",
                  "POST /assistant/attachments",
                  "GET /assistant/sessions/{id}/attachments"
                ]
              },
              {
                "group": "Context",
                "openapi": "openapi.yaml",
                "expanded": false,
                "pages": [
                  "POST /context/add",
                  "POST /context/upload",
                  "POST /context/pick",
                  "GET /context/browse",
                  "GET /context/documents",
                  "GET /context/documents/{id}/chunks",
                  "POST /context/documents/{id}/open",
                  "DELETE /context/documents/{id}"
                ]
              },
              {
                "group": "Conflicts",
                "openapi": "openapi.yaml",
                "expanded": false,
                "pages": [
                  "GET /memory/conflicts",
                  "GET /memory/conflicts/resolved",
                  "POST /memory/conflicts/{id}/resolve",
                  "POST /memory/conflicts/{id}/revert",
                  "POST /memory/conflicts/resolve-auto/stream"
                ]
              },
              {
                "group": "Import",
                "openapi": "openapi.yaml",
                "expanded": false,
                "pages": [
                  "POST /import/sessions/stream",
                  "POST /import/agent-memory/stream",
                  "POST /import/claude-code/notify",
                  "GET /import/claude-code/status",
                  "PUT /import/claude-code/scope"
                ]
              },
              {
                "group": "Daemon",
                "openapi": "openapi.yaml",
                "expanded": false,
                "pages": ["GET /health", "POST /admin/shutdown"]
              }
            ]
          }
        ]
      },
      {
        "tab": "CLI Reference",
        "groups": [
          {
            "group": "CLI",
            "pages": ["cli/overview"]
          },
          {
            "group": "Commands",
            "pages": [
              "cli/daemon",
              "cli/memories",
              "cli/import",
              "cli/graph",
              "cli/context",
              "cli/conflicts"
            ]
          }
        ]
      },
      {
        "tab": "MCP Reference",
        "groups": [
          {
            "group": "MCP",
            "pages": ["mcp/setup", "mcp/tools"]
          },
          {
            "group": "Clients",
            "pages": [
              "mcp/clients/claude-code",
              "mcp/clients/claude-desktop",
              "mcp/clients/cursor",
              "mcp/clients/vs-code",
              "mcp/clients/windsurf",
              "mcp/clients/cline",
              "mcp/clients/zed",
              "mcp/clients/codex",
              "mcp/clients/opencode"
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Website",
        "href": "https://memloom.dev"
      }
    ]
  }
}
