{
  "manifest_version": 3,
  "name": "memloom",
  "version": "0.1.0",
  "description": "Save the page you're on to memloom so your agents can find it later.",
  "key": "",
  "permissions": ["activeTab", "scripting", "contextMenus", "storage"],
  "host_permissions": ["http://127.0.0.1:4319/*"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"],
    "type": "module"
  },
  "action": {
    "default_title": "Save to memloom",
    "default_popup": "popup.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Open the save popup"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "save-for-later@memloom",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
